{%- comment -%}
This snippet structures the micro-data using JSON-LD specification. Please note that for Product especially,
the schema often changes. We try to output as much info as possible, but Google may add new requirements over time,
or change the format of some info
{%- endcomment -%}

{%- if request.page_type == 'product' -%}
  {%- assign days_product_price_valid_until = 10 | times: 86400 -%}

  {%- assign gtin_option = 'gtin' -%}
  {%- if product.selected_or_first_available_variant.barcode != blank -%}
    {%- assign is_barcode_available = true -%}
    {%- assign gtin_string_length = product.selected_or_first_available_variant.barcode | size -%}

    {%- if gtin_string_length == 8 or gtin_string_length == 12 or gtin_string_length == 13 or gtin_string_length == 14 -%}
      {%- assign is_valid_gtin_length = true -%}
      {%- assign gtin_option = gtin_option | append: gtin_string_length -%}
    {%- endif -%}
  {%- endif -%}

  {%- comment -%}
    Only skip default Product when global.product_schema is present.
    faq_schema is additive and can sit alongside default or custom Product.
  {%- endcomment -%}
  {%- if product.metafields.global.product_schema.value != blank -%}
    {%- assign use_product_metafield_schema = true -%}
  {%- else -%}
    {%- capture main_entity_microdata -%}
      "@type": "Product",
      "offers": [
        {%- for variant in product.variants -%}
          {
            "@type": "Offer",
            "name": {{ variant.title | json }},
            "availability": {%- if variant.available -%}"https://schema.org/InStock"{%- else -%}"https://schema.org/OutOfStock"{%- endif -%},
            "price": {{ variant.price | divided_by: 100.0 | json }},
            "priceCurrency": {{ cart.currency.iso_code | json }},
            "priceValidUntil": "{{ 'now' | date: '%s' | plus: days_product_price_valid_until | date: '%Y-%m-%d'}}",
            {%- if variant.sku != blank -%}
              "sku": {{ variant.sku | json }},
            {%- endif -%}
            "url": "{{ product.url }}?variant={{ variant.id }}"
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ],
      {%- assign rating = product.metafields.reviews.rating.value -%}
      {%- assign rc = product.metafields.reviews.rating_count.value | default: 0 -%}

      {%- if rc > 0 and rating.rating != blank -%}
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": {{ rating.rating | json }},
          "bestRating": {{ rating.scale_max | json }},
          {%- if rating.scale_min != blank -%}
          "worstRating": {{ rating.scale_min | json }},
          {%- endif -%}
          "reviewCount": {{ rc | json }}
        },
      {%- endif -%}
      {%- if is_barcode_available and is_valid_gtin_length %}
        "{{gtin_option}}": {{ product.selected_or_first_available_variant.barcode | json }},
        "productId": {{ product.selected_or_first_available_variant.barcode | json }},
      {%- elsif is_barcode_available %}
        "mpn": {{ product.selected_or_first_available_variant.barcode | json }},
        "productId": {{ product.selected_or_first_available_variant.barcode | json }},
      {%- endif %}
      "brand": {
        "@type": "Organization",
        "@id": "https://hodgesbadge.com/#organization",
        "name": {{ product.vendor | json }}
      },
      "name": {{ product.title | json }},
      "description": {{ product.description | strip_html | json }},
      "category": {{ product.type | json }},
      "url": {{ shop.url | append: product.url | json }},
      "sku": {{ product.selected_or_first_available_variant.sku | json }},
      "image": {
        "@type": "ImageObject",
        "url": "https:{{ product.featured_media | img_url: '1024x' }}",
        "image": "https:{{ product.featured_media | img_url: '1024x' }}",
        "name": {{ product.featured_media.alt | json }},
        "width": "1024",
        "height": "1024"
      }
    {%- endcapture -%}
  {%- endif -%}

{%- elsif request.page_type == 'article' -%}
  {%- capture main_entity_microdata -%}
    "@type": "BlogPosting",
    "mainEntityOfPage": "{{ article.url }}",
    "articleSection": {{ blog.title | json }},
    "keywords": "{{ article.tags | join: ', ' }}",
    "headline": {{ article.title | json }},
    "description": {{ article.excerpt_or_content | strip_html | truncatewords: 25 | json }},
    "dateCreated": "{{ article.created_at | date: '%Y-%m-%dT%T' }}",
    "datePublished": "{{ article.published_at | date: '%Y-%m-%dT%T' }}",
    "dateModified": "{{ article.published_at | date: '%Y-%m-%dT%T' }}",
    "image": {
      "@type": "ImageObject",
      "url": "https:{{ article.image | img_url: '1024x' }}",
      "image": "https:{{ article.image | img_url: '1024x' }}",
      "name": {{ article.image.alt | json }},
      "width": "1024",
      "height": "1024"
    },
    "author": {
      "@type": "Person",
      "name": "{{ article.user.first_name | escape }} {{ article.user.last_name | escape }}",
      "givenName": {{ article.user.first_name | json }},
      "familyName": {{ article.user.last_name | json }}
    },
    "publisher": {
      "@type": "Organization",
      "name": {{ shop.name | json }}
    },
    "commentCount": {{ article.comments_count }},
    "comment": [
      {%- for comment in article.comments limit: 5 -%}
        {
          "@type": "Comment",
          "author": {{ comment.author | json }},
          "datePublished": "{{ comment.created_at | date: '%Y-%m-%dT%T' }}",
          "text": {{ comment.content | json }}
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  {%- endcapture -%}
{%- elsif request.page_type == 'collection' -%}
  {%- unless collection.metafields.global.collection_schema.value != blank -%}
    {%- capture main_entity_microdata -%}
      "@type": "CollectionPage",
      "@id": {{ canonical_url | append: '#collection' | json }},
      "name": {{ collection.title | json }},
      "description": {{ collection.description | strip_html | truncate: 300 | json }},
      "url": {{ canonical_url | json }},
      "isPartOf": {
        "@id": "https://hodgesbadge.com/#website"
      },
      "mainEntity": {
        "@type": "ItemList",
        "numberOfItems": {{ collection.products_count | json }},
        "itemListElement": [
          {%- for p in collection.products limit: 24 -%}
            {
              "@type": "ListItem",
              "position": {{ forloop.index }},
              "url": {{ shop.url | append: p.url | json }},
              "name": {{ p.title | json }}
            }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ]
      }
    {%- endcapture -%}
  {%- endunless -%}
{%- endif -%}

{%- capture breadcrumb_entity_microdata -%}
  "@type": "BreadcrumbList",
  "itemListElement": [{
      "@type": "ListItem",
      "position": 1,
      "name": {{ 'general.breadcrumb.home' | t | json }},
      "item": "{{ shop.url }}"
    }

    {%- if request.page_type == 'product' -%}
      {%- liquid
        assign crumb_col = collection
        if crumb_col == blank and product.metafields.custom.primary_collection != blank
          assign crumb_col = product.metafields.custom.primary_collection.value
        endif
      -%}
      {%- if crumb_col != blank -%}
        ,{
          "@type": "ListItem",
          "position": 2,
          "name": {{ crumb_col.title | json }},
          "item": "{{ shop.url }}{{ crumb_col.url }}"
        }, {
          "@type": "ListItem",
          "position": 3,
          "name": {{ product.title | json }},
          "item": "{{ shop.url }}{{ product.url }}"
        }
      {%- else -%}
        ,{
          "@type": "ListItem",
          "position": 2,
          "name": {{ 'collection.general.all_products' | t | json }},
          "item": "{{ shop.url }}{{ routes.all_products_collection_url }}"
        }, {
          "@type": "ListItem",
          "position": 3,
          "name": {{ product.title | json }},
          "item": "{{ shop.url }}{{ product.url }}"
        }
      {%- endif -%}
    {%- elsif request.page_type == 'collection' -%}
        ,{
          "@type": "ListItem",
          "position": 2,
          "name": {{ collection.title | json }},
          "item": "{{ shop.url }}{{ collection.url }}"
        }
    {%- elsif request.page_type == 'blog' -%}
        ,{
          "@type": "ListItem",
          "position": 2,
          "name": {{ blog.title | json }},
          "item": "{{ shop.url }}{{ blog.url }}"
        }
    {%- elsif request.page_type == 'article' -%}
        ,{
          "@type": "ListItem",
          "position": 2,
          "name": {{ blog.title | json }},
          "item": "{{ shop.url }}{{ blog.url }}"
        }, {
          "@type": "ListItem",
          "position": 3,
          "name": {{ article.title | json }},
          "item": "{{ shop.url }}{{ article.url }}"
        }
    {%- elsif request.page_type == 'page' -%}
       ,{
          "@type": "ListItem",
          "position": 2,
          "name": {{ page.title | json }},
          "item": "{{ shop.url }}{{ page.url }}"
        }
    {%- endif -%}
  ]
{%- endcapture -%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [

    {
      "@type": "Organization",
      "@id": "https://hodgesbadge.com/#organization",
      "name": "Hodges Badge Company, Inc.",
      "alternateName": "Hodges Badge",
      "slogan": "Your FIRST PLACE for AWARDS®.",
      "url": "{{ shop.url }}/",
      "telephone": "+18005562440",
      "foundingDate": "1920",
      "email": "info@hodgesbadge.com",
      "description": "America's premier supplier of custom award ribbons, rosettes, medals, trophies, silver, crystal and recognition awards. Handcrafted in the USA since 1920.",
      "logo": {
        "@type": "ImageObject",
        "url": "https://hodgesbadge.com/cdn/shop/files/100yr_hbc_logo_1000x214_b4a03a9d-eb60-4448-bc93-8e8f0018ca3e_360x@2x.png?v=1761578886",
        "width": 1000,
        "height": 214
      },
      "image": {
        "@type": "ImageObject",
        "url": "https://hodgesbadge.com/cdn/shop/files/100yr_hbc_logo_800x409_875b1212-d4a3-488a-917c-6fac6d6ab3c2.png?v=1782114027",
        "width": 800,
        "height": 419
      },
      "sameAs": [
        "https://www.facebook.com/hodgesbadge",
        "https://www.instagram.com/hodgesbadge",
        "https://www.trustpilot.com/review/hodgesbadge.com",
        "https://www.linkedin.com/company/hodges-badge-company",
        "https://www.youtube.com/@HodgesBadge1920",
        "https://www.pinterest.com/hodgesbadge/"
      ],
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+18005562440",
        "contactType": "customer service",
        "availableLanguage": "English"
      },
      "address": [
        {
          "@type": "PostalAddress",
          "streetAddress": "205 Clock Tower Square",
          "addressLocality": "Portsmouth",
          "addressRegion": "RI",
          "postalCode": "02871",
          "addressCountry": "US"
        },
        {
          "@type": "PostalAddress",
          "streetAddress": "6440 Enduro Dr",
          "addressLocality": "Washington",
          "addressRegion": "MO",
          "postalCode": "63090",
          "addressCountry": "US"
        }
      ],
      "areaServed": "US",
      "knowsAbout": [
        "Custom Award Ribbons",
        "Rosette Awards",
        "Medal Awards",
        "Trophy Awards",
        "Silver Awards",
        "Crystal Awards",
        "Dog Show Awards",
        "Equestrian Awards",
        "Fair, 4-H and Festival Awards",
        "Swim Awards",
        "Dance, Gymnastics, and Cheerleading Awards",
        "Track & Field Awards",
        "Recognition Awards",
        "Sports Awards"
      ]
    }

    {%- if request.page_type == 'index' -%}

    ,{
      "@type": "WebSite",
      "@id": "https://hodgesbadge.com/#website",
      "url": "{{ shop.url }}/",
      "name": "Hodges Badge Company, Inc.",
      "description": "Custom rosettes, ribbons, medals, trophies, plaques and recognition awards handcrafted in the USA since 1920.",
      "inLanguage": "en-US",
      "publisher": {
        "@id": "https://hodgesbadge.com/#organization"
      },
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "{{ shop.url }}/pages/search-results-page?q={search_term_string}"
        },
        "query-input": "required name=search_term_string"
      }
    }

    ,{
      "@type": "WebPage",
      "@id": "{{ shop.url }}/#webpage",
      "url": "{{ shop.url }}/",
      "name": "Custom Rosettes & Award Ribbons | Hodges Badge Co. Since 1920",
      "description": "Custom rosettes, ribbons, medals & trophies for horse shows, dog shows, fairs, schools & more. Handcrafted in the USA since 1920.",
      "isPartOf": {
        "@id": "https://hodgesbadge.com/#website"
      },
      "about": {
        "@id": "https://hodgesbadge.com/#organization"
      },
      "inLanguage": "en-US"
    }

    {%- endif -%}

    {%- if main_entity_microdata != blank -%}
    ,{
      {{ main_entity_microdata }}
    }
    {%- endif -%}

    {%- if use_product_metafield_schema and product.metafields.global.product_schema.value != blank -%}
      {%- assign review_count = product.metafields.reviews.rating_count.value | default: 0 -%}
      {%- assign review_rating = product.metafields.reviews.rating.value.rating -%}
      {%- assign review_scale = product.metafields.reviews.rating.value.scale_max -%}
      {%- capture product_schema_json -%}{{ product.metafields.global.product_schema.value | json }}{%- endcapture -%}
      {%- assign product_schema_json = product_schema_json | strip -%}
      {%- assign product_schema_start = product_schema_json | slice: 0 -%}
      {%- capture product_schema_extra -%}{%- endcapture -%}
      {%- if product_schema_start == '{' -%}
        {%- if review_count > 0 and review_rating != blank -%}
          {%- unless product_schema_json contains '"aggregateRating"' -%}
            {%- capture product_schema_extra -%}{{ product_schema_extra }},"aggregateRating":{"@type":"AggregateRating","ratingValue":{{ review_rating | json }},"bestRating":{{ review_scale | json }},"reviewCount":{{ review_count | json }}}{%- endcapture -%}
          {%- endunless -%}
        {%- endif -%}
        {%- unless product_schema_json contains '"brand"' -%}
          {%- capture product_schema_extra -%}{{ product_schema_extra }},"brand":{"@type":"Organization","@id":"https://hodgesbadge.com/#organization","name":{{ product.vendor | json }}}{%- endcapture -%}
        {%- endunless -%}
      {%- endif -%}
    ,
      {%- if product_schema_extra != blank -%}
        {{ product_schema_json | remove_last: '}' }}{{ product_schema_extra }}}
      {%- else -%}
        {{ product_schema_json }}
      {%- endif -%}
    {%- endif -%}

    {%- if request.page_type == 'product' and product.metafields.global.faq_schema.value != blank -%}
    ,{%- render 'faq-schema-json', faq_metafield: product.metafields.global.faq_schema -%}
    {%- endif -%}

    {%- if request.page_type == 'collection' -%}
      {%- if collection.metafields.global.collection_schema.value != blank -%}
    ,{{ collection.metafields.global.collection_schema.value | json }}
        {%- if collection.metafields.global.item_list_schema.value != blank -%}
    ,{{ collection.metafields.global.item_list_schema.value | json }}
        {%- endif -%}
      {%- endif -%}

      {%- if collection.metafields.global.faq_schema.value != blank -%}
    ,{%- render 'faq-schema-json', faq_metafield: collection.metafields.global.faq_schema -%}
      {%- endif -%}
    {%- endif -%}

    {%- if breadcrumb_entity_microdata != blank -%}
    ,{
      {{ breadcrumb_entity_microdata }}
    }
    {%- endif -%}

  ]
}
</script>
